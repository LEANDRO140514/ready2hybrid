# Public InsForge client configuration only.
# Never put project_admin / service / API keys in VITE_* variables.
VITE_INSFORGE_URL=https://your-project.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=

# Optional non-sensitive build marker (PWA update tests). Not an auth grant.
# VITE_SHELL_BUILD_ID=local

# Fixture auth is NOT available via VITE_* in production.
# Playwright uses: npm run dev -- --mode e2e (src/main.e2e.tsx).
# Production builds fail closed if VITE_AUTH_MODE=fixture is set.
